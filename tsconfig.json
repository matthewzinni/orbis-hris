{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES2017"
    ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "allowJs": false,
    "noEmitOnError": false,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "js/**/*.ts"
, "src/types/employeeTypes.ts", "src/types/auditTypes.ts", "src/core/state.ts", "src/ui/employeeAudit.ts", "js/legacy/app.d.ts", "js/legacy/app.ts", "src/modules/dashboard.ts"  ],
  "exclude": [
    "node_modules"
  ]
}