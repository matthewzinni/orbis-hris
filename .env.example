# Copy to .env for local dev (Vite loads VITE_* variables)
#
# Supabase → Integrations → Data API → API URL (use host only, no /rest/v1/)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
# Or Legacy tab → anon public JWT (eyJ...)
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
#
# Public app URL for employee signing links (optional locally; set in Vercel Production)
# VITE_PUBLIC_APP_URL=https://www.orbis-btw.com
#
# Production (Vercel): add the same two variables under Project → Settings →
# Environment Variables for "Production", then redeploy. Names must start with VITE_
# so they are embedded at build time.
#
# Secret key: backend/scripts only — do not expose in the browser
# SUPABASE_SECRET_KEY=sb_secret_...
#
# OpenAI (stay interview AI summary): set on Supabase, not here — see DEPLOY.md
# supabase secrets set OPENAI_API_KEY=sk-...
#
# -----------------------------------------------------------------------------
# Optional — dedicated instance / white-label (BTW Global used when unset)
# See docs/INSTANCE_DEPLOY.md and src/config/instanceConfig.ts
# -----------------------------------------------------------------------------
# VITE_COMPANY_NAME=BTW Global
# VITE_COMPANY_LEGAL_NAME=BTW Global, LLC
# VITE_COMPANY_EMAIL_DOMAIN=btwglobal.com
# VITE_APP_PRODUCT_NAME=Orbis
# VITE_EMPLOYEE_ID_PREFIX=BTW
# VITE_ORG_WIDE_SCOPE_EMAILS=matthew.zinni@btwglobal.com,trent.wynne@btwglobal.com,brent.wynne@btwglobal.com
# VITE_LEADERSHIP_PORTAL_EXCLUDE_EMAILS=matthew.zinni@btwglobal.com,trent.wynne@btwglobal.com,brent.wynne@btwglobal.com
# VITE_FEATURE_JANUS=true
# VITE_FEATURE_INVESTIGATIONS=true
# VITE_FEATURE_CARE_ENGAGEMENT=true
# VITE_FEATURE_CANDIDATES=true
#
# -----------------------------------------------------------------------------
# Training / demo environment only (never set on BTW production)
# See docs/TRAINING_DEMO.md
# -----------------------------------------------------------------------------
# VITE_DEMO_INSTANCE=true
# VITE_COMPANY_NAME=Northline Manufacturing
# VITE_COMPANY_LEGAL_NAME=Northline Manufacturing, LLC
# VITE_COMPANY_EMAIL_DOMAIN=northline-demo.local
# VITE_EMPLOYEE_ID_PREFIX=NLM
# VITE_ORG_WIDE_SCOPE_EMAILS=trainer@northline-demo.local
# VITE_LEADERSHIP_PORTAL_EXCLUDE_EMAILS=trainer@northline-demo.local
# VITE_FEATURE_JANUS=false
