# Copy to .env for local dev (Vite loads VITE_* variables)
#
# Supabase → Integrations → Data API → API URL (use host only, no /rest/v1/)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# Supabase → Settings → API Keys → Publishable key (sb_publishable_...)
# Or Legacy tab → anon public JWT (eyJ...)
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
#
# Secret key: backend/scripts only — do not expose in the browser
# SUPABASE_SECRET_KEY=sb_secret_...
